<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Foto2.Converters"
             x:Class="Foto2.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Kleurenschema -->
            <Color x:Key="PrimaryBlue">#1E90FF</Color>
            <Color x:Key="SecondaryOrange">#FFA500</Color>
            <Color x:Key="NeutralGray">#F5F5F5</Color>
            <Color x:Key="DarkGray">#333333</Color>
            <Color x:Key="WhiteColor">#FFFFFF</Color>
            <Color x:Key="AccentGreen">#32CD32</Color>
            <Color x:Key="OverlayColor">#80000000</Color> <!-- Zwarte overlay met 50% transparantie -->

            <!-- Stijlen -->
            <!-- Header Label Style -->
            <Style TargetType="Label" x:Key="HeaderLabelStyle">
                <Setter Property="FontFamily" Value="MontserratBold" />
                <Setter Property="FontSize" Value="24" />
                <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="0,20,0,20" />
            </Style>

            <!-- Input Entry Style -->
            <Style TargetType="Entry" x:Key="InputEntryStyle">
                <Setter Property="BackgroundColor" Value="#FFFFFFAA" /> <!-- Witte achtergrond met 67% transparantie -->
                <Setter Property="TextColor" Value="{StaticResource DarkGray}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource DarkGray}" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- Primary Button Style -->
            <Style TargetType="Button" x:Key="PrimaryButtonStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlue}" />
                <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- Secondary Button Style -->
            <Style TargetType="Button" x:Key="SecondaryButtonStyle">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondaryOrange}" />
                <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontFamily" Value="OpenSansRegular" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- Converter Registraties -->
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
            <converters:BooleanToHorizontalOptionsConverter x:Key="BooleanToHorizontalOptionsConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
