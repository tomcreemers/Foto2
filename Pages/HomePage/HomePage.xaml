<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foto2.Pages.HomePage"
             Title="Home">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" /> <!-- Scrollable content -->
            <RowDefinition Height="70" /> <!-- Fixed navigation buttons -->
        </Grid.RowDefinitions>

        <!-- Photos List -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Photos}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" Spacing="10">
                        <!-- Username and Description -->
                        <StackLayout Spacing="5">
                            <Label Text="{Binding Poster}" 
                                   FontSize="Medium" 
                                   FontAttributes="Bold" 
                                   LineBreakMode="WordWrap" />

                            <Label Text="{Binding Description}" 
                                   FontSize="Medium" 
                                   TextColor="Gray" 
                                   LineBreakMode="WordWrap" />
                        </StackLayout>

                        <!-- Photo with Rounded Corners -->
                        <Frame HasShadow="False" CornerRadius="10" Padding="0" Margin="0">
                            <Image Source="{Binding Path}" 
                                   Aspect="AspectFill" 
                                   HeightRequest="300" />
                        </Frame>

                        <!-- Action Buttons -->
                        <StackLayout Orientation="Horizontal" Spacing="15" Margin="0,5,0,0">
                            <!-- Like Button -->
                            <ImageButton Source="{Binding LikeButtonImage}" 
                                         Command="{Binding BindingContext.ToggleLikeCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                         CommandParameter="{Binding .}" 
                                         HeightRequest="30" WidthRequest="30" />
                            <Label Text="{Binding Likes}" FontSize="Small" VerticalTextAlignment="Center" />

                            <!-- Comment Button -->
                            <ImageButton Source="comment.png" 
                                         Command="{Binding BindingContext.CommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                         CommandParameter="{Binding .}" 
                                         HeightRequest="30" WidthRequest="30" />

                            <!-- Share Button -->
                            <ImageButton Source="share.png" 
                                         Command="{Binding BindingContext.ShareCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                         CommandParameter="{Binding .}" 
                                         HeightRequest="30" WidthRequest="30" />
                        </StackLayout>

                        <!-- Reaction Section -->
                        <StackLayout Spacing="5">
                            <Label Text="{Binding FirstReaction}" FontSize="Small" TextColor="Gray" />

                            <!-- Wrap clickable text with TapGestureRecognizer -->
                            <Label Text="See all reactions" FontSize="Small" TextColor="Blue">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.ViewAllCommentsCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                          CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </StackLayout>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Navigation Buttons -->
        <StackLayout Grid.Row="1" Orientation="Horizontal" BackgroundColor="White" Padding="10">
            <Button Text="Upload" HorizontalOptions="FillAndExpand" Clicked="OnUploadClicked" />
            <Button Text="Account" HorizontalOptions="FillAndExpand" Clicked="OnAccountClicked" />
            <Button Text="Explore" HorizontalOptions="FillAndExpand" Clicked="OnExploreClicked" />
        </StackLayout>
    </Grid>
</ContentPage>
