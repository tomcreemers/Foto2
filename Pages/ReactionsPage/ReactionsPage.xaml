<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foto2.Pages.ReactionsPage"
             Title="Reactions">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" /> <!-- Scrollable content -->
            <RowDefinition Height="Auto" /> <!-- Back button -->
        </Grid.RowDefinitions>

        <!-- Reactions List -->
        <CollectionView Grid.Row="0" ItemsSource="{Binding Reactions}" Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10" Spacing="5" BackgroundColor="White" Margin="0,0,0,10">
                        <!-- Username -->
                        <Label Text="{Binding Username}"
                               FontSize="Medium"
                               FontAttributes="Bold"
                               TextColor="Black" />

                        <!-- Reaction Content -->
                        <Label Text="{Binding Content}"
                               FontSize="Small"
                               TextColor="Gray"
                               LineBreakMode="WordWrap" />

                        <!-- Timestamp -->
                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy HH:mm}'}"
                               FontSize="Small"
                               TextColor="LightGray"
                               HorizontalOptions="End" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Back Button -->
        <Button Text="Back"
                Grid.Row="1"
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="10"
                Clicked="OnBackClicked" />
    </Grid>
</ContentPage>
