<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Foto2.Pages.ThemeDetailPage"
             Title="{Binding Name}">
    <StackLayout Padding="20">
        <!-- Subscribe/Unsubscribe Button -->
        <Button Text="{Binding SubscribeButtonText}"
                Command="{Binding ToggleSubscriptionCommand}"
                Margin="0,0,0,20" />

        <!-- Theme Description -->
        <Label Text="{Binding Description}" FontSize="Medium" Margin="0,0,0,20" />

        <!-- Assignments List -->
        <Label Text="Assignments:" FontSize="Medium" FontAttributes="Bold" Margin="0,20,0,10" />
        <CollectionView ItemsSource="{Binding Assignments}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding Title}" FontSize="Medium" />
                        <Label Text="{Binding Deadline, StringFormat='Due: {0:dd MMM yyyy}'}" FontSize="Small" TextColor="Gray" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
